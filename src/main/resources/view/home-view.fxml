<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Le StackPane permet de superposer l'application et le calque du popup -->
<StackPane fx:id="rootStackPane" prefHeight="650.0" prefWidth="950.0" stylesheets="@../style/quick-acces.css"
           xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="org.example.controller.HomeController">
    <children>

        <!-- CONTENU PRINCIPAL DE L'APPLICATION -->
        <VBox focusTraversable="true" styleClass="main-container">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
                    <children>
                        <TextField editable="false" focusTraversable="false" styleClass="header-title"
                                   text="Mes Raccourcis et Commandes" HBox.hgrow="ALWAYS" />
                        <Button fx:id="addButton" focusTraversable="false" onAction="#handleCreatePopup" styleClass="add-button" text="➕" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="20.0" />
                    </VBox.margin>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="custom-scroll-pane" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <FlowPane fx:id="cardsFlowPane" hgap="20.0" styleClass="cards-grid" vgap="20.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <StackPane fx:id="popupOverlay" visible="false" styleClass="popup-overlay" />

    </children>
</StackPane>
