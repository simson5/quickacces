<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="toastRoot" alignment="CENTER_LEFT" spacing="12.0" styleClass="toast-base"
      stylesheets="@../style/quick-acces.css" xmlns="http://javafx.com" xmlns:fx="http://javafx.com">
    <children>
        <!-- L'icône dynamique (ex: ❌, ℹ️, ⚠️) -->
        <Label fx:id="toastIcon" styleClass="toast-icon" text="ℹ️" />

        <!-- Le message de notification -->
        <Label fx:id="toastMessage" styleClass="toast-message" text="Message de notification" wrapText="true" />
    </children>
    <padding>
        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
    </padding>
</HBox>

